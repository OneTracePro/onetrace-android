<?xml version="1.0" encoding="utf-8"?>
<!-- The expanded view of a carousel notification (RemoteViews: only framework layouts and views). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <ImageView
        android:id="@+id/onetrace_carousel_image"
        android:layout_width="match_parent"
        android:layout_height="160dp"
        android:adjustViewBounds="false"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop" />

    <TextView
        android:id="@+id/onetrace_carousel_title"
        style="@style/TextAppearance.Compat.Notification.Title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:ellipsize="end"
        android:maxLines="1" />

    <TextView
        android:id="@+id/onetrace_carousel_body"
        style="@style/TextAppearance.Compat.Notification"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="2" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/onetrace_carousel_prev"
            style="@style/TextAppearance.Compat.Notification.Title"
            android:layout_width="48dp"
            android:layout_height="40dp"
            android:contentDescription="@string/onetrace_carousel_previous"
            android:gravity="center"
            android:text="‹"
            android:textSize="26sp" />

        <TextView
            android:id="@+id/onetrace_carousel_counter"
            style="@style/TextAppearance.Compat.Notification"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center" />

        <TextView
            android:id="@+id/onetrace_carousel_next"
            style="@style/TextAppearance.Compat.Notification.Title"
            android:layout_width="48dp"
            android:layout_height="40dp"
            android:contentDescription="@string/onetrace_carousel_next"
            android:gravity="center"
            android:text="›"
            android:textSize="26sp" />
    </LinearLayout>
</LinearLayout>
